meta {
  name: 1. Crear Marca (POST)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/marcas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Toyota-{{marcaSuffix}}",
    "pais": "Japón"
  }
}

script:pre-request {
  const randomNum = Math.floor(1000 + Math.random() * 9000);
  bru.setVar("marcaSuffix", randomNum);
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("marcaId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.nombre: isDefined
}

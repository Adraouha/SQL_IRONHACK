meta {
  name: 1. Crear Coche (POST)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/coches
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "marca": "Coche1",
    "modelo": "co-1",
    "matricula": "0001-coche",
    "precio": 10000.0
  }
}

assert {
  res.status: eq 201
  res.body.marca: eq Cupra
  res.body.matricula: eq 9876-CUP
  res.body.id: isDefined
}

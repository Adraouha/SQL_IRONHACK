meta {
  name: 5. Actualizar Coche (PUT)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/coches/{{cocheId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "marca": "Cupra",
    "modelo": "Formentor VZ5 Extreme",
    "matricula": "{{cocheMatricula}}",
    "precio": 62500.0
  }
}

assert {
  res.status: eq 200
  res.body.modelo: eq Formentor VZ5 Extreme
  res.body.precio: eq 62500.0
}
